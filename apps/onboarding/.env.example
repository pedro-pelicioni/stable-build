# Browser build settings. Every VITE_* value is copied into the public bundle.
# Never put a private key, STABLE_BUILD_VERIFIER_KEY, or LLM_API_KEY in a VITE_* name.

# testnet (default) or mainnet. Mainnet also needs the typed phrase and a fee cap in the UI.
VITE_NETWORK=testnet

# Optional RPC. Empty uses the public endpoint for VITE_NETWORK.
# A local arc-anvil fork of mainnet: http://127.0.0.1:8545 with VITE_NETWORK=mainnet.
VITE_RPC_URL=

# GoLiveRegistry address for the network above. Reads and transactions wait until this is set.
VITE_REGISTRY_ADDRESS=

# "true" sends composer messages to /api/chat. Anything else keeps the scripted guide only.
VITE_CHAT_ENABLED=false

# Server only (Vite does not inline these). Used by /api/chat, never by the browser bundle.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# Optional RPC override for the serverless function. Empty uses the public Arc endpoint.
# ARC_RPC_URL=
