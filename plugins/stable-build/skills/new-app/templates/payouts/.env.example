# Browser build settings. Every VITE_* value is copied into the public bundle:
# never put a private key or any secret here.

# testnet (default) or mainnet. Mainnet also needs the typed confirmation and a per-batch cap in the UI.
VITE_NETWORK=testnet

# Optional custom RPC URL. Empty means the public endpoint from
# https://docs.arc.io/arc/references/rpc-endpoints
VITE_RPC_URL=
